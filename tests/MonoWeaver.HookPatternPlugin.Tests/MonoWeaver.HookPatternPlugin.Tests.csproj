<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>MonoWeaver.PatternTests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Fixtures/**/*.cs" />
    <Compile Include="Generation/**/*.cs" />
    <Compile Include="Infrastructure/**/*.cs" />
    <ProjectReference Include="../../src/MonoWeaver.PatternGeneration/MonoWeaver.PatternGeneration.csproj" />
    <PackageReference Include="MonoWeaver" Version="$(MonoWeaverVersion)" />
    <PackageReference Include="Mono.Cecil" Version="$(CecilPackageVersion)" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" PrivateAssets="all" />
    <PackageReference Include="xunit" Version="2.9.3" PrivateAssets="all" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="PatternSources/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="CleanCopiedPatternAssets" BeforeTargets="PrepareForBuild">
    <RemoveDir Directories="$(TargetDir)PatternSources;$(TargetDir)PatternAssemblies" />
  </Target>
</Project>
