<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <AssemblyName>MonoWeaver.PatternGeneration</AssemblyName>
    <RootNamespace>MonoWeaver.Patterns.Generation</RootNamespace>
    <Description>Tooling-only reverse generator from selected CIL locations to MonoWeaver lambda patterns.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mono.Cecil" Version="$(CecilPackageVersion)" />
    <PackageReference Include="MonoWeaver" Version="$(MonoWeaverVersion)" />
  </ItemGroup>

</Project>
